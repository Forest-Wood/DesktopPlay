{
  "name": "desktopplay",
  "version": "0.2.1",
  "description": "Windows 双角色桌宠：DeepSeek 余额与 Codex 编程额度",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Forest-Wood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Forest-Wood/DesktopPlay.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "io.github.forestwood.desktopplay",
    "productName": "DesktopPlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DesktopPlay-${version}-Setup-x64.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "DesktopPlay-${version}-Portable-x64.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Forest-Wood",
        "repo": "DesktopPlay"
      }
    ]
  }
}
